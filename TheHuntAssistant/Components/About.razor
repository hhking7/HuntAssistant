<MudGrid Class="mx-2" Justify="Justify.FlexStart" Style="background-color: #2D3033">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudText Class="my-1">The purpose of this app is to alleviate some of the administrative hassle that is involved with the Hunt.</MudText>
        <MudText Class="my-1">In no way is it meant for commercial use, any use beyond the Hunt or any form of distribution other than its original distribution source.</MudText>
        <MudText Class="my-4" Typo="Typo.h4">Credits:</MudText>
        <MudStack Row="true" Class="my-2">
            <MudText Typo="Typo.h5" Style="@($"color: {Colors.Amber.Accent2}; font-style: italic; font-weight: 400")">App made by Hhking:</MudText>
            <MudStack Row="true" Justify="Justify.Center" Style="height: 60px">
                <MudLink Href="https://www.twitch.tv/hhking" Style="Width: 50px">
                    <MudImage Src="./images/twitch.png" Fluid="true" ObjectFit="ObjectFit.ScaleDown"></MudImage>
                </MudLink>
                <MudLink Href="https://discord.gg/Vbrp3S2ahe" Style="Width: 50px">
                    <MudImage Src="./images/discord.png" Fluid="true" ObjectFit="ObjectFit.ScaleDown"></MudImage>
                </MudLink>
            </MudStack>
        </MudStack>
        <MudStack Row="true" Class="my-2">
            <MudText Typo="Typo.h5" Style="@($"color: {Colors.Amber.Accent2}; font-style: italic; font-weight: 400")">Official website of the Hunt:</MudText>
            <MudStack Row="true" Justify="Justify.Center" Style="height: 60px">
                <MudLink Href="https://atg.borderlandshunt.com/" Style="Width: 50px">
                    <MudText Typo="Typo.h5">https://atg.borderlandshunt.com/</MudText>
                </MudLink>
            </MudStack>
        </MudStack>
        <MudStack Row="true" Class="my-2">
            <MudText Typo="Typo.h5" Style="@($"color: {Colors.Amber.Accent2}; font-style: italic; font-weight: 400")">Official Borderlands Community Fundraising Team:</MudText>
            <MudStack Row="true" Justify="Justify.Center" Style="height: 60px">
                <MudLink Href="https://discord.gg/Y9mVK2SPpP" Style="Width: 50px">
                    <MudImage Src="./images/discord.png" Fluid="true" ObjectFit="ObjectFit.ScaleDown"></MudImage>
                </MudLink>
            </MudStack>
        </MudStack>
    </MudContainer>
</MudGrid>

